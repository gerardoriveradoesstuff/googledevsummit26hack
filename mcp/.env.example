# Copy to .env (gitignored). Loaded automatically on start.

# Base URL of the PHP API ("la puerta"), WITHOUT /v1. Locally: php -S 127.0.0.1:8084 -t api
DISTRIBUIDORA_API_URL=http://127.0.0.1:8084
# Production example: https://demo.ouwap.com/api

# MOCK=1 serves the same demo data from fixtures/seed-data.json in memory (no PHP/MySQL needed).
MOCK=0

# HTTP listen address for the MCP endpoint (POST /mcp).
PORT=3333
HOST=0.0.0.0

# Optional: comma-separated Host header allow-list (DNS-rebinding protection), e.g. your tunnel host.
# Host names only, no port. Tailscale Funnel example (see ../TAILSCALE.md):
# ALLOWED_HOSTS=localhost,127.0.0.1,laptop.tail1234.ts.net

# Timezone used for "today"/"tomorrow" and display. The API stores times in -07:00 / LA time.
TZ_DISPLAY=America/Los_Angeles
