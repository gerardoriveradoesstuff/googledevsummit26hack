{
  "name": "distribuidora-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Remote MCP server (Streamable HTTP) that lets the Gemini app read and create orders in Distribuidora de Productos through its PHP API.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:mock": "MOCK=1 node dist/index.js",
    "smoke": "tsx scripts/smoke.ts",
    "inspector": "npx @modelcontextprotocol/inspector"
  },
  "engines": {
    "node": ">=20.12"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "^5.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
